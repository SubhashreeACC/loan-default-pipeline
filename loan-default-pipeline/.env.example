# .env.example
# Copy to .env and fill in real values. Never commit the actual .env file.

# ── Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loan_default
DB_USER=mlops
DB_PASSWORD=change_me_in_production

# ── MLflow ────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# ── Airflow ───────────────────────────────────
AIRFLOW_FERNET_KEY=generate_with_python_cryptography_fernet
AIRFLOW_SECRET_KEY=change_me
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=change_me

# ── Serving / API ─────────────────────────────
API_BASE_URL=http://localhost:8000

# ── Data ingestion ────────────────────────────
DATA_INGESTION_DIR=/data/incoming
REPORT_DIR=/tmp/evidently_reports

# ── CI/CD (GitHub Actions secrets — set in repo settings, not here) ──
# DEPLOY_SSH_KEY
# DEPLOY_USER
# PROD_HOST
# PROD_API_HOST
# AIRFLOW_HOST
