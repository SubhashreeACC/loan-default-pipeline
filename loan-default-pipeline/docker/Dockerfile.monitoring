# docker/Dockerfile.monitoring
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libpq-dev gcc && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY docker/requirements.api.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    streamlit==1.32.0

COPY src/ ./src/
COPY config/ ./config/
COPY src/monitoring/dashboard.py ./dashboard.py

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8001

CMD ["streamlit", "run", "dashboard.py", \
     "--server.port=8001", "--server.address=0.0.0.0", \
     "--server.headless=true"]
