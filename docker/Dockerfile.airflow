# docker/Dockerfile.airflow
# Extends the base Airflow image with project-specific Python dependencies
# baked in, so DAGs can import src.* modules without runtime pip installs.

FROM apache/airflow:2.8.1-python3.11

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl && rm -rf /var/lib/apt/lists/*

USER airflow
COPY docker/requirements.airflow.txt /tmp/requirements.airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements.airflow.txt

# Project source is mounted as a volume in docker-compose.yml for live-reload
# during development; for production, COPY it in instead:
# COPY src/ /opt/airflow/src/
# COPY config/ /opt/airflow/config/

ENV PYTHONPATH=/opt/airflow
